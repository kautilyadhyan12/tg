# The test server (ROADMAP Stage 5 item 21a-i): one machine serves the api, as `Caddyfile` does,
# and the console itself from `infra/web` (built on a laptop with VITE_API_URL set to the api's
# https address, then copied across). `docker-compose.selfhost.yml` mounts this file in place of
# `Caddyfile` and that one beside it.
import Caddyfile.api

{$WEB_DOMAIN} {
	root * /srv/web

	# No other site shows the console in a frame (18d-ii, round one, H2): the page's own guard
	# draws nothing there, and this header stops the browser from framing it at all. A gym's
	# public page as its embed is the one page that may be framed (`framing.js`, `mayBeFramed`).
	@notEmbed not {
		path_regexp ^/gyms/[^/]+/?$
		query embed=1
	}
	header @notEmbed Content-Security-Policy "frame-ancestors 'none'"
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# The built files carry their content's hash in their names, so they never change in place;
	# the page itself is read again on every visit so a new build is seen at once
	# (matched on the address asked for: every page is index.html, or home.html at the site's own address).
	@hashed {
		path /assets/*
		file
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# A built file that is not there (a visit in the middle of an update) is "not found", kept by
	# nobody, and never the console's page kept for a year in its place (12a's security pass, L1).
	@missingAsset {
		path /assets/*
		not file
	}
	header @missingAsset Cache-Control "no-store"
	@page not path /assets/*
	header @page Cache-Control "no-cache"

	encode zstd gzip
	handle /assets/* {
		file_server
	}
	handle {
		# The front page (ROADMAP Stage 4 item 12a): the site's own address, and only that one, shows
		# `home.html`. Every other address is the console as before, `/login` and its pages included.
		@front path /
		rewrite @front /home.html
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "\?.*$" ""
				# A page's address in the Referer header can carry a token too (the account restore link,
				# Square's return): it is not kept.
				request>headers>Referer delete
			}
		}
	}
}
