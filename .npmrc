engine-strict=true
save-workspace-protocol=rolling
# Windows refuses a file name over 260 characters, and an Android build of the
# phone app passes it under the default 120 (measured 2026-10-12: 266) and, in a
# folder with a longer name than ai-home-gym, under 40 (2026-10-14: 261 in
# ai-home-gym-b, 263 in the exercise folders). At 30 every long name is 10 shorter.
virtual-store-dir-max-length=30
