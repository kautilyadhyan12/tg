# Test files whose exact bytes are the test: a CSV's CRLF, bare CR or LF line ends
# and its code page must reach every checkout unchanged (core.autocrlf would
# otherwise rewrite them on Windows).
apps/api/test/fixtures/member-list/** -text
# The gym page's phone photos (20c-iv-b): their bytes are the test, too.
apps/api/test/fixtures/photos/*.jpg binary
apps/api/test/fixtures/photos/*.png binary
apps/api/test/fixtures/photos/*.webp binary
# Run on the Linux test server as they are (21a-ii): a CR at a line end breaks bash and cron.
infra/*.sh text eol=lf
infra/*.cron text eol=lf
