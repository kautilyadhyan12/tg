# ======================================================================
# AI Home Gym — Environment Variables
# Copy this file to `.env` (kept out of git) and fill in real values.
# ======================================================================

# --- Shared ---
NODE_ENV=development
LOG_LEVEL=debug

# --- Database ---
MONGO_URI=mongodb://localhost:27017/ai_home_gym
REDIS_URL=redis://localhost:6379

# --- Auth backend (Node) ---
AUTH_PORT=3001
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# Google OAuth (create credentials at https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Email (dev: use Mailtrap / Ethereal; prod: SendGrid/SES)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@aihomegym.local

# Frontend URL (for email links, CORS)
FRONTEND_URL=http://localhost:5173

# --- ML backend (FastAPI) ---
ML_PORT=8000
# MUST match JWT_SECRET in auth backend
ML_JWT_SECRET=change-me-to-a-long-random-string

# Groq API for primary LLM (get key at https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# Ollama fallback (optional, only if you want offline support)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b-instruct-q4_K_M

# Model artifact paths (inside backend-ml/model_artifacts/)
YOLO_MODEL_PATH=model_artifacts/yolov8s-pose.pt
FORM_LSTM_PATH=model_artifacts/form_lstm.pt
NCF_MODEL_PATH=model_artifacts/ncf.pt
CALORIE_XGB_PATH=model_artifacts/calorie_xgb.json
FAISS_INDEX_PATH=model_artifacts/faiss_index

# --- Frontend (Vite) ---
VITE_AUTH_API_URL=http://localhost:3001/api
VITE_ML_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws
