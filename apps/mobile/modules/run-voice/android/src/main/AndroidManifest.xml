<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- A planned run's steps are said on time with the screen off (37d-ii). -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Android 11 and later show an app only the services it names: the phone's text-to-speech. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.TTS_SERVICE" />
    </intent>
  </queries>
</manifest>
