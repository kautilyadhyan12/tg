# ML artifacts (too big for git — download/train on setup)
backend-ml/model_artifacts/*.pt
backend-ml/model_artifacts/*.pkl
backend-ml/model_artifacts/*.bin
backend-ml/model_artifacts/*.onnx
backend-ml/model_artifacts/faiss_index/
ml-training/*/data/
ml-training/*/checkpoints/
ml-training/*/wandb/
ml-training/*/runs/

# Notebooks heavy output
ml-training/*/notebooks/*.html

# Coverage
coverage/
.coverage
htmlcov/

# Misc
*.tsbuildinfo

# Turborepo
.turbo/

# P1.3 recording rig — raw videos, pose model, debug frame dumps stay out of git
backend-ml/recordings/
backend-ml/models/
backend-ml/*.png
backend-ml/*.mp4

# The camera's bundled assets (~25 MB): MediaPipe's WebAssembly runtime and the
# pose model. Fetched and sha256-verified by `apps/web/tools/fetch-pose-assets.mjs`,
# which `dev` and `build` both run, so they are always present when it matters.
# Out of git because this repo has no LFS and the §3.6 ladder will add a second
# model — a BUILD has internet, a WORKOUT does not, and that is the line.
apps/web/public/mediapipe/
apps/web/public/models/*.task

# infra: the production env file lives on the deploy host, never in the repo
# (R3.6, Part 8 §1 escrow). .gitignore's `.env` rule does not cover this name.
infra/api.env

# Local browser profile used for driving the app (holds cookies/session state)
.codex-chrome-profile/

# pnpm content-addressable store, if configured locally
.pnpm-store/

# Review scratch at the repo root: T3 prompts and the diffs they were run on,
# plus NEXT-CARD kickoff prompts. Working notes for a chat, never a source —
# DECISIONS.md, OWED.md, BACKLOG.md and RUNBOOK/ are where anything durable
# goes. Ten of these had been committed by accident and 89 more sat untracked,
# which is how `git status` stopped being readable and how `git add -A` became
# dangerous here. The archive of the consumed ones is `.scratch/`, on disk and
# out of git; the ones still in play stay at the root.
.scratch/
t3-*
NEXT-*

# Guardrail rules written by the `/hookify` plugin. These are one operator's
# local reminders to the chat ("never do X"), not project law — CLAUDE.md is.
# Kd's ruling 2026-08-26: ignored, never committed.
.claude/hookify.*
