{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "typecheck": {
      "inputs": ["src/**", "test/**", "scripts/**", "app.config.ts", "index.ts", "copies.json", "vitest.config.{ts,js}", "tsconfig.json", "package.json"],
      "dependsOn": ["^typecheck"]
    },
    "lint": {
      "inputs": [
        "src/**",
        "test/**",
        "tools/**",
        "scripts/**",
        "eslint.config.js",
        "eslint.config.mjs",
        "metro.config.js",
        "jest.config.js",
        "vitest.config.{ts,js}",
        "app.config.ts",
        "index.ts",
        "copies.json",
        "tsconfig.json",
        "package.json"
      ]
    },
    "test": {
      "inputs": ["src/**", "test/**", "tools/**", "scripts/**", "assets/**", "app.config.ts", "copies.json", "vitest.config.{ts,js}", "jest.config.js", "tsconfig.json", "package.json"],
      "dependsOn": ["^typecheck"]
    },
    "build": {
      "inputs": ["src/**", "tools/**", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"],
      "dependsOn": ["^build"]
    }
  }
}
